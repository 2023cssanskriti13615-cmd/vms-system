# Copy this file to ".env" and fill in your own values.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# --- Email (Brevo HTTP API) ------------------------------------------
# Cloud platforms (Render included) block outbound SMTP ports on their
# free tier, so email is sent through Brevo's HTTPS API instead.
# 1. Sign up free at https://www.brevo.com
# 2. Settings -> SMTP & API -> API Keys -> Generate a new API key
# 3. Settings -> Senders -> add and verify the email you will send from
BREVO_API_KEY=your-brevo-api-key-here
MAIL_USERNAME=youraddress@gmail.com
MAIL_SENDER_NAME=Visitor Desk

# --- Organisation ---------------------------------------------------
ORG_NAME=Visitor Management System
ORG_TAGLINE=Invitation, QR pass and gate verification

# --- Accounts created on first run ----------------------------------
EMPLOYEE_USERNAME=employee
EMPLOYEE_PASSWORD=employee123
EMPLOYEE_NAME=Employee Desk
GUARD_USERNAME=guard
GUARD_PASSWORD=guard123
GUARD_NAME=Security Officer

# --- Public address -------------------------------------------------
# Leave blank on a laptop. On Render it is filled in automatically.
# APP_BASE_URL=https://your-app.onrender.com

# Where the SQLite file lives. On Render with a disk attached, use:
# DB_PATH=/var/data/visitors.db
